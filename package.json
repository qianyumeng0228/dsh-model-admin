{
  "name": "model-admin",
  "displayName": "Model Admin",
  "description": "AI 平台账号与签到管理台：统一管理多家 AI 编程服务（WorkBuddy/CodeBuddy、CodeArts、Qoder、TRAE、Cline、Loomy、Raccoon、MiniMax、ZCode、LobsterAI、Gemini）的登录账号，自动完成每日签到与积分领取，汇总各账号余额与临期积分。不注册模型路由，只做账号与签到的管理面。",
  "version": "0.1.0",
  "author": "model-admin contributors",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "account-manager",
    "checkin",
    "credits"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "smoke": "MODEL_ADMIN_NO_PACK=1 node scripts/smoke.mjs",
    "integration": "node --import ./test/stubs/register.mjs scripts/integration.mjs",
    "check": "node --test \"test/*.test.js\" && MODEL_ADMIN_NO_PACK=1 node scripts/smoke.mjs && node --import ./test/stubs/register.mjs scripts/integration.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.1 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1 || ^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
